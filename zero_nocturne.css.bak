<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Zero Nocturne</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500&family=Bebas+Neue&family=Orbitron:wght@700&family=Rajdhani:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --green: #00ff9c;
  --green-dark: #00c97a;
  --black: #000000;
  --dark: #0a0a0a;
  --gray: #1a1a1a;
  --white: #ffffff;
  --text-muted: #aaaaaa;
}

body {
  font-family: 'Rajdhani', Arial, sans-serif;
  background: var(--black);
  color: var(--white);
  overflow-x: hidden;
}

nav {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 48px;
  background: transparent;
}

.logo { display: flex; align-items: center; }
.logo img { height: 130px; width: auto; object-fit: contain; }

.nav-links { display: flex; gap: 60px; list-style: none; }
.nav-links a {
  color: var(--white);
  text-decoration: none;
  font-family: 'Bebas Neue', sans-serif;
  font-size: 15px;
  letter-spacing: 4px;
  text-transform: uppercase;
  transition: color .2s;
}
.nav-links a:hover { color: var(--green); }

.nav-icons { display: flex; gap: 35px; align-items: center; }
.nav-icons svg {
  width: 20px; height: 20px;
  fill: none; stroke: var(--white); stroke-width: 1.8;
  cursor: pointer; transition: stroke .2s;
}
.nav-icons svg:hover { stroke: var(--green); }
.cart-badge { position: relative; }
.cart-badge span {
  position: absolute; top: -6px; right: -8px;
  background: var(--green); color: var(--black);
  font-size: 9px; font-weight: 700;
  width: 16px; height: 16px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}

.hero {
  position: relative;
  width: 100%;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: #060c09;
}

.hero-bg {
  position: absolute; inset: 0; z-index: 1;
  background:
    radial-gradient(ellipse 60% 80% at 70% 50%, rgba(0,180,70,.13) 0%, transparent 65%),
    radial-gradient(ellipse 30% 40% at 85% 30%, rgba(0,255,106,.07) 0%, transparent 60%),
    linear-gradient(160deg, #000 0%, #050f08 50%, #000 100%);
}

.hero-bg-images {
  position: absolute; inset: 0;
  z-index: 2;
  pointer-events: none;
}
.bg-warehouse {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.5;
}

.lines {
  position: absolute; right: 0; top: 0; bottom: 0;
  width: 55%; pointer-events: none; overflow: hidden;
  z-index: 3;
}
.lines::before, .lines::after {
  content: ''; position: absolute; top: 0; bottom: 0; width: 2px;
  background: linear-gradient(to bottom, transparent 0%, var(--green) 40%, var(--green) 60%, transparent 100%);
  opacity: .35; box-shadow: 0 0 18px 4px rgba(0,255,106,.4);
}
.lines::before { left: 30%; }
.lines::after  { left: 55%; }

.fog {
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 180px; z-index: 4;
  background: linear-gradient(to top, rgba(0,255,106,.06) 0%, transparent 100%);
  pointer-events: none;
}

.hero-content {
  position: relative; z-index: 10;
  padding: 160px 48px 80px;
  max-width: 520px;
}

.tagline {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 18px; letter-spacing: 5px;
  color: var(--green); text-transform: uppercase;
  margin-bottom: 0px;
  opacity: 0; animation: fadeUp .6s ease forwards .2s;
}
.headline {
  font-family: 'Orbitron', sans-serif; font-weight: 700;
  font-size: clamp(56px, 7vw, 90px); line-height: .95;
  text-transform: uppercase; margin-bottom: 24px;
  opacity: 0; animation: fadeUp .7s ease forwards .4s;
  margin-top: 0;
  
}
.headline .green { color: var(--green); }
.sub {
  font-size: 17px; font-weight: 400;
  color: var(--text-muted); line-height: 1.6;
  max-width: 340px; margin-bottom: 40px;
  opacity: 0; animation: fadeUp .7s ease forwards .6s;
}
.cta-row {
  display: flex; gap: 16px; align-items: center;
  opacity: 0; animation: fadeUp .7s ease forwards .8s;
}

.btn-primary {
  background: var(--green); color: var(--black); border: none;
  padding: 14px 28px; font-family: 'Bebas Neue', sans-serif;
  font-weight: 700; font-size: 13px; letter-spacing: 2px;
  text-transform: uppercase; cursor: pointer;
  display: flex; align-items: center; gap: 10px;
  transition: background .2s, transform .15s; text-decoration: none;
}
.btn-primary:hover { background: var(--green-dark); transform: translateX(3px); }
.btn-outline {
  background: transparent; color: var(--white);
  border: 1.5px solid rgba(255,255,255,.5);
  padding: 14px 28px; font-family: 'Barlow', sans-serif;
  font-weight: 500; font-size: 13px; letter-spacing: 2px;
  text-transform: uppercase; cursor: pointer;
  transition: border-color .2s, color .2s; text-decoration: none;
}
.btn-outline:hover { border-color: var(--white); color: var(--white); }

.hero-model {
  position: absolute; right: 5%; bottom: -20px;
  height: 95%; z-index: 6;
  display: flex; align-items: flex-end;
  opacity: 0; animation: modelIn .9s ease forwards .5s;
}
.hero-model img {
  height: 100%; object-fit: contain;
  filter: drop-shadow(0 0 40px rgba(0,255,106,.2));
}

.trust-bar {
  background: #0d0d0d; border-top: 1px solid #1a1a1a;
  display: flex; justify-content: space-around; align-items: center;
  padding: 20px 48px; flex-wrap: wrap; gap: 16px;
}
.trust-item { display: flex; align-items: center; gap: 12px; }
.trust-icon { width: 36px; height: 36px; stroke: var(--green); fill: none; stroke-width: 1.6; flex-shrink: 0; }
.trust-text { display: flex; flex-direction: column; }
.trust-label { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--white); font-family: 'Bebas Neue', sans-serif; }
.trust-sub { font-size: 10px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes modelIn {
  from { opacity: 0; transform: translateX(30px); }
  to   { opacity: 1; transform: translateX(0); }
}

@media (max-width: 768px) {
  nav { padding: 16px 20px; }
  .nav-links { display: none; }
  .hero-content { padding: 120px 20px 200px; max-width: 100%; }
  .hero-model { right: -5%; height: 70%; }
  .trust-bar { padding: 16px 20px; gap: 20px; }
  .logo img { height: 40px; }
}
  </style>
</head>
<body>

<nav>
  <div class="logo">
    <img src="data:image/jpeg;base64," alt="Zéro Nocturne" />
  </div>
  <ul class="nav-links">
    <li><a href="#">Hombre</a></li>
    <li><a href="#">Mujer</a></li>
    <li><a href="#">Accesorios</a></li>
    <li><a href="#">Nuevos</a></li>
    <li><a href="#">Colecciones</a></li>
  </ul>
  <div class="nav-icons">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/></svg>
    <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
    <div class="cart-badge">
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      <span>1</span>
    </div>
  </div>
</nav>

<section class="hero">
  <div class="hero-bg"></div>

  <div class="hero-bg-images">
    <img class="bg-warehouse" src="data:image/png;base64," alt="" />
    <img class="bg-smoke" src="data:image/png;base64," alt="" />
  </div>

  <div class="lines"></div>
  <div class="fog"></div>

  <div class="hero-content">
    <p class="tagline">Entrena en silencio.</p>
    <h1 class="headline">
      DOMINA<br>LA<br>
      <span class="green">OSCURIDAD.</span>
    </h1>
    <p class="sub">Ropa deportiva diseñada para quienes entrenan en silencio, dominan en la oscuridad y destacan por su disciplina.</p>
    <div class="cta-row">
      <a href="#" class="btn-primary">
        Comprar Ahora
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="#" class="btn-outline">Ver Colección</a>
    </div>
  </div>

  <div class="hero-model">
    <img src="modelo-Photoroom.png" alt="modelo" />
  </div>
</section>

<div class="trust-bar">
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="1"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    <div class="trust-text"><span class="trust-label">Envíos</span><span class="trust-sub">a todo el país</span></div>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
    <div class="trust-text"><span class="trust-label">Pagos 100%</span><span class="trust-sub">seguros</span></div>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><polyline points="23 20 23 14 17 14"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
    <div class="trust-text"><span class="trust-label">Cambios</span><span class="trust-sub">y devoluciones fáciles</span></div>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
    <div class="trust-text"><span class="trust-label">Materiales</span><span class="trust-sub">premium</span></div>
  </div>
  <div class="trust-item">
    <svg class="trust-icon" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
    <div class="trust-text"><span class="trust-label">Soporte</span><span class="trust-sub">24 / 7</span></div>
  </div>
</div>

</body>
</html>